{
  "name": "seunghwan-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/validate-content.mjs && astro build && node scripts/normalize-legacy.mjs && pagefind --site dist && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "new:post": "node scripts/new-post.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:publication": "node scripts/publication-check.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.5",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "cheerio": "1.2.0",
    "gray-matter": "4.0.3",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3"
  }
}
