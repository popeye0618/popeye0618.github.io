---
interface Props {
  theme: 'matching' | 'football' | 'photo';
}
const { theme } = Astro.props;
---

<div class:list={['project-art', 'project-cover', theme]} aria-hidden="true">
  {theme === 'matching' ? (
    <>
      <span class="cover-kicker">CAMPUS MATCHING</span>
      <div class="connection-orbit orbit-one"></div>
      <div class="connection-orbit orbit-two"></div>
      <span class="cover-word matching-word">
        co<span>matching.</span>
      </span>
      <span class="cover-caption">가톨릭대학교 축제 매칭 서비스</span>
    </>
  ) : theme === 'football' ? (
    <>
      <div class="pitch-lines">
        <div></div>
      </div>
      <span class="cover-kicker">BUCHEON FC × COMATCHING</span>
      <span class="cover-word football-word">
        MATCH
        <br />
        <i>TOGETHER</i>
      </span>
      <span class="cover-caption">부천 FC 관중 매칭 서비스</span>
      <span class="football-number">FC</span>
    </>
  ) : (
    <>
      <div class="photo-frame frame-one"></div>
      <div class="photo-frame frame-two"></div>
      <div class="photo-frame frame-three"></div>
      <span class="cover-kicker">IMAGE PROCESSING / HARUCUT</span>
      <span class="cover-word photo-word">Harucut</span>
      <span class="cover-caption">네 장의 사진을 한 장으로</span>
    </>
  )}
</div>
