---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter(
  (h) => h.depth === 2 || h.depth === 3,
);
---

{headings.length > 0 && (
  <aside class="toc" data-pagefind-ignore>
    <details open>
      <summary>이 페이지에서</summary>
      <nav aria-label="본문 목차">
        {headings.map((h) => (
          <a class:list={{ nested: h.depth === 3 }} href={`#${h.slug}`}>
            {h.text}
          </a>
        ))}
      </nav>
    </details>
  </aside>
)}
