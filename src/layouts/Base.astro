---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
}
const {
  title,
  description = profile.description,
  noindex = false,
  canonical,
} = Astro.props;
const path = Astro.url.pathname;
const url = new URL(canonical ?? path, Astro.site);
const menus = [
  { url: '/', label: '홈' },
  { url: '/projects/', label: '프로젝트' },
  { url: '/resume/', label: '이력' },
  { url: '/blog/', label: '블로그' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title ? `${title} · 천승환` : '천승환 · Backend Developer'}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta
      property="og:type"
      content={
        path.startsWith('/blog/') && path.split('/').length === 4
          ? 'article'
          : 'website'
      }
    />
    <meta property="og:title" content={title ?? '천승환 · Backend Developer'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="천승환 블로그"
      href="/rss.xml"
    />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          theme === 'light' || theme === 'dark'
            ? theme
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches
          ? 'dark'
          : 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      본문으로 바로가기
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="천승환 홈">
          <span class="brand-mark" aria-hidden="true">
            s.
          </span>
          천승환<span class="brand-sub">개발 기록</span>
        </a>
        <nav aria-label="주 메뉴">
          {menus.map((menu) => (
            <a
              href={menu.url}
              aria-current={
                (menu.url === '/' ? path === '/' : path.startsWith(menu.url))
                  ? 'page'
                  : undefined
              }
            >
              {menu.label}
            </a>
          ))}
        </nav>
        <button
          id="theme-toggle"
          class="icon-button"
          aria-label="어두운 테마로 전환"
          title="테마 전환"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <path d="M20.7 13.2A9 9 0 0 1 10.8 3.3 9 9 0 1 0 20.7 13.2Z" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <div>
        <strong>천승환</strong>
        <p>만들고, 운영하고, 배운 것을 기록합니다.</p>
      </div>
      <div class="footer-links">
        <a href={profile.github}>GitHub ↗</a>
        <a href={`mailto:${profile.email}`}>이메일 ↗</a>
        <a href="/rss.xml">RSS ↗</a>
      </div>
      <small>© {new Date().getFullYear()} Seunghwan Cheon</small>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const updateLabel = () =>
        button?.setAttribute(
          'aria-label',
          document.documentElement.dataset.theme === 'dark'
            ? '밝은 테마로 전환'
            : '어두운 테마로 전환',
        );
      updateLabel();
      button?.addEventListener('click', () => {
        const theme =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {}
        updateLabel();
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener(
        'change',
        (event) => {
          let saved;
          try {
            saved = localStorage.getItem('theme');
          } catch {}
          if (!saved) {
            document.documentElement.dataset.theme = event.matches
              ? 'dark'
              : 'light';
            updateLabel();
          }
        },
      );
      document.querySelectorAll('.prose pre').forEach((pre) => {
        const copy = document.createElement('button');
        copy.className = 'copy-code';
        copy.textContent = '복사';
        copy.setAttribute('aria-label', '코드 복사');
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(
              pre.querySelector('code')?.textContent ?? '',
            );
            copy.textContent = '복사됨';
          } catch {
            copy.textContent = '직접 선택해 복사';
          }
          setTimeout(() => (copy.textContent = '복사'), 2000);
        });
        pre.append(copy);
      });
      document
        .querySelector<HTMLButtonElement>('[data-print]')
        ?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
