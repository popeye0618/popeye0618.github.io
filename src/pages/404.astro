---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다" noindex>
  <section class="card pad archive">
    <div class="eyebrow">404</div>
    <h1 style="margin-top:16px">페이지를 찾을 수 없습니다</h1>
    <p>
      주소가 바뀌었거나 아직 공개되지 않은 페이지입니다. 홈이나 블로그에서
      원하는 글을 찾아보세요.
    </p>
    <div class="actions">
      <a class="button" href="/">
        홈으로 →
      </a>
      <a class="button secondary" href="/blog/">
        블로그 보기
      </a>
    </div>
  </section>
</Base>
