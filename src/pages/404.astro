---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없어요" noindex>
  <section class="card pad archive">
    <div class="eyebrow">404</div>
    <h1 style="margin-top:16px">이 페이지는 찾을 수 없어요</h1>
    <p>
      주소가 바뀌었거나 아직 공개되지 않은 페이지예요. 홈이나 블로그에서 다시
      찾아보세요.
    </p>
    <div class="actions">
      <a class="button" href="/">
        홈으로 →
      </a>
      <a class="button secondary" href="/blog/">
        블로그 보기
      </a>
    </div>
  </section>
</Base>
