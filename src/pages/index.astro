---
import Base from '../layouts/Base.astro';
import ProjectArt from '../components/ProjectArt.astro';
import PostList from '../components/PostList.astro';
import { projects, publicPosts } from '../lib/content';
import { career } from '../data/profile';
const selected = await projects();
const posts = (await publicPosts()).slice(0, 3);
const metrics = selected.find((p) => p.data.slug === 'comatching')!.data
  .metrics;
---

<Base>
  <section class="work-stage" aria-labelledby="stage-title">
    <div class="stage-intro">
      <h1 id="stage-title">
        천승환 <span>— Backend Developer</span>
      </h1>
      <p>서비스를 만들고, 운영하고, 개선합니다.</p>
    </div>
    <div class="stage-floor" aria-hidden="true"></div>
    <div
      class="work-reel"
      tabindex="0"
      role="region"
      aria-label="대표 프로젝트 갤러리. 좌우 방향키 또는 스크롤로 이동"
    >
      {selected.map((project, index) => (
        <a
          class="work-panel"
          href={`/projects/${project.data.slug}/`}
          data-index={index}
        >
          <ProjectArt theme={project.data.theme} />
          <div class="panel-label">
            <span>
              <small>{String(index + 1).padStart(2, '0')} /</small>{' '}
              {project.data.title}
            </span>
            <span class="panel-arrow" aria-hidden="true">
              ↗
            </span>
          </div>
          <span class="panel-description">{project.data.summary}</span>
        </a>
      ))}
    </div>
    <div class="stage-bottom">
      <a class="stage-index" href="/projects/">
        SELECTED WORK <span> / ALL PROJECTS ↗</span>
      </a>
      <div class="gallery-controls">
        <button data-step="-1" aria-label="이전 프로젝트">
          ←
        </button>
        <span id="gallery-position" aria-live="polite">
          01 / 03
        </span>
        <button data-step="1" aria-label="다음 프로젝트">
          →
        </button>
      </div>
      <a href="#about" class="stage-scroll">
        SCROLL TO EXPLORE ↓
      </a>
    </div>
  </section>
  <section class="editorial-intro" id="about">
    <div class="eyebrow">01 — ABOUT</div>
    <div>
      <h2>
        대학 축제의 만남에서
        <br />
        경기장의 연결까지.
      </h2>
      <p>
        Comatching의 백엔드 개발과 팀장을 맡아 서비스를 운영했습니다. 그 경험은
        부천 FC 외주로 이어졌고, 지금은 성능과 안정성 문제를 측정하며 더 나은
        구조를 고민합니다.
      </p>
      <a class="text-link" href="/resume/">
        천승환의 이력 보기 ↗
      </a>
    </div>
  </section>
  <section class="operating-record" aria-labelledby="record-title">
    <div class="record-heading">
      <h2 id="record-title">Comatching 운영 기록</h2>
      <p>가톨릭대학교 축제</p>
    </div>
    <div class="record-values">
      {metrics
        .filter((m) => ['users', 'matches', 'revenue'].includes(m.key))
        .sort(
          (a, b) =>
            ['users', 'matches', 'revenue'].indexOf(a.key) -
            ['users', 'matches', 'revenue'].indexOf(b.key),
        )
        .map((m) => (
          <div>
            <span>{m.label}</span>
            <strong>{m.value}</strong>
          </div>
        ))}
    </div>
    <p class="footnote">
      약 5회 운영 기준 · 이용자는 회차별 합산(중복 포함) · 수익은 비용 차감 전
      기준
    </p>
  </section>
  <div class="editorial-bottom">
    <section>
      <div class="eyebrow">02 — CURRENTLY</div>
      <h2>{career.company}</h2>
      <p>{career.role}</p>
      <div class="tags">
        {career.workStack.map((t) => (
          <span>{t}</span>
        ))}
      </div>
      <a class="text-link" href="/resume/">
        경력과 기술 ↗
      </a>
    </section>
    <section>
      <div class="section-heading">
        <h2>개발 기록</h2>
        <a class="text-link" href="/blog/">
          모든 글 ↗
        </a>
      </div>
      <PostList posts={posts} compact />
    </section>
  </div>
  <script>
    const reel = document.querySelector<HTMLElement>('.work-reel');
    const panels = [...document.querySelectorAll<HTMLElement>('.work-panel')];
    const counter = document.querySelector('#gallery-position');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let active = -1,
      frame = 0;
    function update() {
      if (!reel) return;
      const center = reel.scrollLeft + reel.clientWidth / 2;
      let closest = Infinity;
      let nextActive = 0;
      panels.forEach((panel, index) => {
        const distance = panel.offsetLeft + panel.offsetWidth / 2 - center;
        if (Math.abs(distance) < closest) {
          closest = Math.abs(distance);
          nextActive = index;
        }
      });
      if (nextActive === active) return;
      active = nextActive;
      panels.forEach((panel, index) =>
        panel.classList.toggle('is-current', index === active),
      );
      if (counter)
        counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(panels.length).padStart(2, '0')}`;
      document
        .querySelectorAll<HTMLButtonElement>('[data-step]')
        .forEach(
          (button) =>
            (button.disabled =
              Number(button.dataset.step) < 0
                ? active === 0
                : active === panels.length - 1),
        );
    }
    function move(step: number) {
      if (!reel) return;
      const next =
        panels[Math.max(0, Math.min(panels.length - 1, active + step))];
      reel.scrollTo({
        left: next.offsetLeft - (reel.clientWidth - next.offsetWidth) / 2,
        behavior: reduced.matches ? 'instant' : 'smooth',
      });
    }
    document
      .querySelectorAll<HTMLButtonElement>('[data-step]')
      .forEach((button) =>
        button.addEventListener('click', () =>
          move(Number(button.dataset.step)),
        ),
      );
    reel?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        move(event.key === 'ArrowRight' ? 1 : -1);
      }
    });
    reel?.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  </script>
</Base>
