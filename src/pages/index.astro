---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { projects, publicPosts } from '../lib/content';
import { career } from '../data/profile';
const allProjects = await projects();
const posts = (await publicPosts()).slice(0, 3);
const metrics = allProjects.find((p) => p.data.slug === 'comatching')!.data
  .metrics;
const metric = (key: string) => metrics.find((m) => m.key === key)!;
---

<Base>
  <section class="dashboard" aria-label="소개와 운영 경험">
    <div class="card hero-intro">
      <div class="role-label">BACKEND DEVELOPER</div>
      <h1>
        사용자가 쓰는 서비스를
        <br />
        만들고, <span>개선합니다.</span>
      </h1>
      <p>
        안녕하세요, 백엔드 개발자 천승환입니다.
        <br />
        실서비스 운영부터 성능과 안정성 개선까지,
        <br />
        직접 부딪히며 배운 경험을 기록합니다.
      </p>
      <div class="actions">
        <a class="button" href="/projects/">
          프로젝트 둘러보기 <span aria-hidden="true">→</span>
        </a>
        <a class="button secondary" href="/resume/">
          이력 보기
        </a>
      </div>
    </div>
    <div class="card hero-metrics">
      <div class="card-heading">
        <h2>Comatching 운영 기록</h2>
        <span class="tiny-badge">실서비스</span>
      </div>
      <div class="metric-label">{metric('users').label}</div>
      <div class="big-value">{metric('users').value}</div>
      <p class="metric-label">대학 축제에서 만난 사용자</p>
      <div class="metric-bottom">
        <div>
          <strong>{metric('runs').value}</strong>
          <small>{metric('runs').label}</small>
        </div>
        <div>
          <strong>{metric('revenue').value}</strong>
          <small>{metric('revenue').label}</small>
        </div>
      </div>
      <p class="footnote">운영자 추정치 · 매출은 비용 차감 전 금액</p>
    </div>
  </section>
  <section aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">직접 만든 서비스</h2>
      <a class="text-link" href="/projects/">
        전체 프로젝트 →
      </a>
    </div>
    <div class="projects-grid">
      {allProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
  <div class="lower-grid">
    <section class="card pad career-summary">
      <div class="card-heading">
        <h2>지금 하고 있는 일</h2>
        <span class="tiny-badge">CAREER</span>
      </div>
      <div class="career-icon" aria-hidden="true">
        ⌘
      </div>
      <div class="eyebrow">{career.role}</div>
      <h3>{career.company}</h3>
      <p>{career.description}</p>
      <div class="tags">
        {career.workStack.map((t) => (
          <span>{t}</span>
        ))}
      </div>
      <a class="text-link" href="/resume/">
        경력과 기술 살펴보기 →
      </a>
    </section>
    <section class="card pad">
      <div class="card-heading">
        <h2>최근 개발 기록</h2>
        <a class="text-link" href="/blog/">
          전체 글 →
        </a>
      </div>
      <PostList posts={posts} compact />
    </section>
  </div>
</Base>
