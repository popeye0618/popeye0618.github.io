---
import Base from '../layouts/Base.astro';
import { profile, career, certifications } from '../data/profile';
import { projects } from '../lib/content';
const list = await projects();
---

<Base title="이력">
  <div class="resume-header">
    <header class="page-heading">
      <div class="eyebrow">RESUME</div>
      <h1>
        천승환{' '}
        <span style="font-size:20px;color:var(--muted)">백엔드 개발자</span>
      </h1>
      <p>{profile.description}</p>
    </header>
    <button class="button secondary" data-print>
      인쇄 / PDF로 저장 ↗
    </button>
  </div>
  <div class="resume-grid">
    <div class="resume-main">
      <section class="card pad">
        <h2>경력</h2>
        <div class="timeline">
          <h3>{career.company}</h3>
          <p>{career.role}</p>
          <p>BXM·Oracle을 사용하는 코어뱅킹 개발 업무를 담당합니다.</p>
          <div class="tags">
            {career.workStack.map((t) => (
              <span>{t}</span>
            ))}
          </div>
        </div>
      </section>
      <section class="card pad">
        <h2>프로젝트 경험</h2>
        {list.map((p) => (
          <div class="timeline" style="margin-bottom:26px">
            <h3>
              <a href={`/projects/${p.data.slug}/`}>{p.data.title} ↗</a>
            </h3>
            <p>{p.data.role}</p>
            <p>{p.data.summary}</p>
            <p>
              <strong>{p.data.highlight}</strong>
            </p>
          </div>
        ))}
      </section>
      <section class="card pad">
        <h2>협업과 리더십</h2>
        <p>
          Comatching의 4인 팀에서 백엔드 개발과 팀장을 맡았습니다.
          PM·디자이너·프론트엔드 개발자와 함께 회의를 주도하고, 의견 차이를
          조율하며 서비스 운영을 준비했습니다.
        </p>
      </section>
    </div>
    <aside class="resume-side">
      <section class="card pad">
        <h2>기술 경험</h2>
        <div class="skill-group">
          <h3>회사 업무</h3>
          <div class="tags">
            {career.workStack.map((t) => (
              <span>{t}</span>
            ))}
          </div>
        </div>
        <div class="skill-group">
          <h3>개인 프로젝트</h3>
          <div class="tags">
            {career.projectStack.map((t) => (
              <span>{t}</span>
            ))}
          </div>
          <p style="margin-top:14px">
            프로젝트별로 캐시, 메시지 처리, 작업 복구와 부하 실험을
            적용했습니다. 구체적인 범위는 프로젝트 상세에 정리했습니다.
          </p>
        </div>
      </section>
      <section class="card pad">
        <h2>자격증</h2>
        {certifications.map((certificate) => (
          <div class="certification-row">
            <h3>{certificate.name}</h3>
            <time datetime={certificate.date}>{certificate.displayDate}</time>
          </div>
        ))}
      </section>
      <section class="card pad">
        <h2>학력</h2>
        <h3>가톨릭대학교</h3>
        <p style="margin-top:10px">
          모교 축제를 위한 매칭 서비스를 개발·운영했습니다.
        </p>
      </section>
      <section class="card pad">
        <h2>연락처</h2>
        <div class="contact-list">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.github}>github.com/popeye0618 ↗</a>
        </div>
      </section>
    </aside>
  </div>
</Base>
